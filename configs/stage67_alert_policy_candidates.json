    "notification_candidate": "gate positive-run start, never every positive point",
    "cooldown_eligibility": "current_timestamp-last_emitted_timestamp >= cooldown_seconds",
    "suppressed_candidate": "do not update last emitted time; no deferred notification inside same gate run",
    "event_boundary": "do not reset gate or cooldown at label onset",
    "synthetic_context": "replay existing full sample prefix through event end; reuse only source-normal predictions whose raw coordinates/time and all eight features match unmodified pre-event copy; after-event unscored rows unused",
